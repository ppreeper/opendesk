#!/usr/bin/env bash
# Shared helper functions for opendesk commands.

# opendesk_distro_playbook
#
# Detect the running distribution and echo the name of the matching desktop
# playbook (without the .yml extension).
#
#   - Linux Mint 22 (Ubuntu-based) -> desktop-mint22
#   - LMDE 7 (Debian-based)        -> desktop-lmde7
#
# Returns non-zero and prints an error to stderr for unsupported systems.
opendesk_distro_playbook() {
	if [ ! -r /etc/os-release ]; then
		printf 'Cannot read /etc/os-release; unable to detect distribution\n' >&2
		return 1
	fi

	# shellcheck disable=SC1091
	. /etc/os-release

	if [ "${ID:-}" != "linuxmint" ]; then
		printf 'Unsupported distribution: %s (expected Linux Mint 22 or LMDE 7)\n' \
			"${PRETTY_NAME:-unknown}" >&2
		return 1
	fi

	# LMDE reports ID_LIKE=debian, while mainline Mint is Ubuntu-based.
	case " ${ID_LIKE:-} " in
		*ubuntu*) printf 'desktop-mint22\n' ;;
		*)        printf 'desktop-lmde7\n' ;;
	esac
}

# :command.command_functions
# :command.function
opendesk_setup_command() {

	# src/setup_command.sh
	# opendesk bootstrap: install the prerequisites needed to run the Ansible setup.
	# Safe to re-run; an existing checkout is updated in place.

	OPENDESK_HOME="${OPENDESK_HOME:-$HOME/.local/share/opendesk}"
	OPENDESK_REPO="${OPENDESK_REPO:-https://github.com/ppreeper/opendesk.git}"

	info() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
	warn() { printf '\033[1;33mwarning:\033[0m %s\n' "$*" >&2; }

	# 1. Ensure uv (fast Python package manager and runner) is available.
	if ! command -v uv >/dev/null 2>&1; then
		info "Installing uv"
		if command -v curl >/dev/null 2>&1; then
			curl -LsSf https://astral.sh/uv/install.sh | sh
		elif command -v wget >/dev/null 2>&1; then
			wget -qO- https://astral.sh/uv/install.sh | sh
		else
			warn "Neither curl nor wget is available to install uv"
			exit 1
		fi
		# shellcheck disable=SC1090
		. "$HOME/.local/bin/env" 2>/dev/null || true
		export PATH="$HOME/.local/bin:$PATH"
	fi

	command -v uv >/dev/null 2>&1 || { warn "uv is not on PATH after install"; exit 1; }

	# 2. Clone the repository, or update it if it already exists.
	if [ -d "$OPENDESK_HOME/.git" ]; then
		info "Updating $OPENDESK_HOME"
		git -C "$OPENDESK_HOME" pull --ff-only
	else
		info "Cloning $OPENDESK_REPO into $OPENDESK_HOME"
		mkdir -p "$(dirname "$OPENDESK_HOME")"
		git clone "$OPENDESK_REPO" "$OPENDESK_HOME"
	fi

	cd "$OPENDESK_HOME" || exit 1

	# 3. Sync the Python virtual environment (ansible, ansible-lint, molecule).
	info "Syncing Python dependencies (uv sync)"
	uv sync

	# 4. Install the Ansible collection dependencies into ./collections.
	info "Installing Ansible collections"
	uv run ansible-galaxy collection install -r collections/requirements.yml -p collections

	# 5. Wire up direnv so the virtualenv activates automatically on `cd`.
	if command -v direnv >/dev/null 2>&1; then
		if ! grep -qs "direnv hook bash" "$HOME/.bashrc"; then
			printf '\neval "$(direnv hook bash)"\n' >> "$HOME/.bashrc"
			info "Added direnv hook to ~/.bashrc"
		fi
		direnv allow "$OPENDESK_HOME" >/dev/null 2>&1 || true
	fi

	info "Setup complete"
	cat <<EOF

opendesk is installed at: $OPENDESK_HOME

Next steps:
	cd $OPENDESK_HOME
	./opendesk detect            # show which desktop playbook applies
	./opendesk desktop           # run it against localhost
	./opendesk play <playbook>   # run an explicit playbook
	./opendesk role <role>       # run a single role

EOF

}

# :command.function
opendesk_detect_command() {

	# src/detect_command.sh
	if [ -r /etc/os-release ]; then
		# shellcheck disable=SC1091
		. /etc/os-release
	fi

	printf 'Distribution: %s\n' "${PRETTY_NAME:-unknown}"

	if playbook="$(opendesk_distro_playbook)"; then
		printf 'Desktop playbook: %s\n' "$playbook"
	else
		exit 1
	fi

}

# :command.function
opendesk_desktop_command() {

	# src/desktop_command.sh
	local target playbook become_opts root
	target="${args[target]:-localhost}"

	# Run from the repository root so ansible.cfg and relative paths resolve.
	root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
	cd "$root" || exit 1

	playbook="$(opendesk_distro_playbook)" || exit 1

	printf 'Detected desktop playbook: %s\n' "$playbook"

	[ "$target" = "localhost" ] && become_opts="-K" || become_opts=""

	echo "uv run ansible-playbook -l ${target} -b ${PLAYBOOK_DIR}/${playbook}.yml ${become_opts}"
	uv run ansible-playbook -l "${target}" -b "${PLAYBOOK_DIR}/${playbook}.yml" ${become_opts}

}

